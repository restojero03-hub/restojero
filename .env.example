# Run `vercel env pull .env.local` to fill most of these from the Vercel project.

# Public site address. Change this one value when you move to a final domain.
NEXT_PUBLIC_SITE_URL="https://restojero.vercel.app"

# Database. Without it, the site shows the starter copy in content/defaults.ts.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Dashboard login. Only verified emails on this comma-separated list can get in.
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
ADMIN_EMAILS=""

# Image uploads from the dashboard.
BLOB_READ_WRITE_TOKEN=""

# Optional: also email each contact form message.
# RESEND_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_TO_EMAIL=""

# Optional: Cloudflare spam check on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Public site address. Change this one value when you move to a final domain.
NEXT_PUBLIC_SITE_URL="https://restojero.vercel.app"

# Contact form. All five below are required, otherwise the form is replaced by
# LinkedIn and Upwork links. Turnstile is required so a script can't fill your inbox.
# RESEND_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_TO_EMAIL=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
